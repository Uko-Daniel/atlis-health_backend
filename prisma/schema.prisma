// ============================================================
// Atlis Health — Prisma Schema
// Updated with EVEE CDSS support
// Additions: Encounter, Vital, Diagnosis, Allergy,
//            EveeEvaluation, EveeAlert
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ────────────────────────────────────────────────────

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Department {
  LABORATORY
  RADIOLOGY
  CARDIOLOGY
  PHARMACY
  GENERAL
  EMERGENCY
  PAEDIATRICS
  OBSTETRICS
  SURGERY
  ADMINISTRATION
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum MedStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum StaffRole {
  SUPER_ADMIN    // Global tenant access
  ADMIN           // Full scoped tenent access
  DOCTOR          // Clinical oversight & prescribing
  NURSES          // Patient monitoring & med administration
  LAB_SCIENTIST       
  IMAGING_TECH     
  PHARMACIST      // Medication fulfillment & verification
  RECEPTIONIST    // Registration, scheduling & patient data
  BILLING_OFFICER // Payments & insurance
  PROCUREMENT_OFFICER
  HIM_OFFICER     // Records auditing & data privacy
  MANAGER         // Operational oversight & inventory
  IT_SUPPORT      // System maintenance
}

enum ResultStatus {
  PENDING
  VERIFIED
  FINALIZED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TemplateType {
  LAB
  IMAGING
  OTHER
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  UNCONFIRMED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  SUSPECTED
}

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  FOLLOW_UP
  PROCEDURE
  TELEMEDICINE
}

enum EveeSeverity {
  CRITICAL
  HIGH
  MODERATE
  LOW
  INFO
}

enum EveeDomain {
  ALLERGY
  DRUG_INTERACTION
  DOSAGE
  VITALS
  LAB
  HISTORY
  COMORBIDITY
  PREVENTIVE
  PREGNANCY
  PAEDIATRIC
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum PayerType {
  NHIA
  HMO
  SELF_PAY
  CORPORATE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  VETTED
  PAID
  REJECTED
}

enum LeaveStatus {
  ACTIVE    // currently working
  ON_LEAVE  // temporarily away
  SICK      // sick leave
  SUSPENDED // disciplinary
}

// ── CORE MODELS ───────────────────────────────────────────────

model Tenant {
  id                  String               @id @default(cuid())
  facilityName        String
  subdomain           String               @unique
  customDomain        String?              @unique
  themePrimaryColor   String?              @default("#5580F4")
  logoUrl             String?
  planTier            PlanTier             @default(TIER_1)
  subscriptionStatus  SubscriptionStatus   @default(ACTIVE)
  licenseExpiresAt    DateTime
  gracePeriodEndsAt   DateTime?
  eveeEnabled         Boolean              @default(false)
  videoConsultEnabled Boolean              @default(false)
  videoConsultMetered Boolean              @default(true)
  customDomainEnabled Boolean              @default(false)
  prioritySupport     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  patients          Patient[]
  payers             Payer[]
  claims            Claim[]
  suppliers         Supplier[]
  inventoryItems    InventoryItem[]
  requests          Request[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  purchaseOrders    PurchaseOrder[]
  staff             Staff[]
  permissions       TenantPermission[]
  billingPeriods    BillingPeriod[]
  services          Service[]
  templates         Template[]
  signupRequests    SignupRequest[]
  settings          TenantSetting[]
  audits            AuditLog[]

  @@index([subdomain])
  @@index([customDomain])
}

model TenantPermission {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  permissionKey String
  allowedRoles  StaffRole[]
  updatedAt     DateTime    @updatedAt
  updatedBy     String

  @@unique([tenantId, permissionKey])
}

model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
}

model BillingPeriod {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  activeUserCount   Int
  encounterCount    Int
  videoMinutesUsed  Int           @default(0)
  calculatedAmount  Decimal
  status            BillingStatus @default(DRAFT)

  @@index([tenantId])
}

// ── HMO / NHIA ────────────────────────────────────────────────

model Payer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String    // "NHIA", "AXA Mansard", "Self-Pay"
  type      PayerType
  contactInfo String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tariffs   Tariff[]
  claims    Claim[]
  patients  Patient[]  // patients covered by this payer

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Tariff {
  id          String   @id @default(cuid())
  payerId     String
  payer       Payer    @relation(fields: [payerId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  agreedPrice Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([payerId, serviceId])
}

model Claim {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id])
  payerId     String
  payer       Payer       @relation(fields: [payerId], references: [id])
  encounterId String?
  encounter   Encounter?  @relation(fields: [encounterId], references: [id])
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id])
  status      ClaimStatus @default(DRAFT)
  amount      Decimal
  notes       String?
  submittedAt DateTime?
  vettedAt    DateTime?
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
  @@index([patientId])
  @@index([payerId])
  @@index([status])
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  gender      Gender
  dob         DateTime
  phoneNumber String?
  email       String?  @unique
  nok         NextOfKin?
  adress      String?
  maritalStatus MaritalStatus?
  nationality String?
  occupation  String?
  religion    String?
  payer   Payer?  @relation(fields: [payerId], references: [id])
  payerId String?
  NIN         String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records      Record[]
  orders       Order[]
  claims Claim[]
  results      Result[]
  patientUsers PatientUser[]
  admissions   Admission[]
  visitors     Visitor[]

  allergies    Allergy[]
  encounters   Encounter[]
  eveeEvals    EveeEvaluation[]
  vitals       Vital[]
  diagnoses    Diagnosis[]
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String

  @@index([tenantId])
}

model NextOfKin {
  id          String   @id @default(cuid())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String   @unique
  firstName   String
  lastName    String
  relation    String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Visitor {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  gender      Gender
  phoneNumber String
  relation    String
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String
  arrivedAt   DateTime
  departedAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Record {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Existing relations
  results     Result[]
  medications Medication[]
  report      Report[]

  // New relations
  encounters  Encounter[]
}

// ── ENCOUNTER ─────────────────────────────────────────────────
// Represents a single clinical visit or consultation.
// Vitals and Diagnoses are recorded per encounter.

model Encounter {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id])
  recordId       String
  record         Record        @relation(fields: [recordId], references: [id])
  attendingStaff String        // Staff ID of attending doctor/nurse
  type           EncounterType @default(OUTPATIENT)
  chiefComplaint String?       // e.g. "Chest pain for 2 days"
  notes          String?       // Free text clinical notes
  encounteredAt  DateTime      @default(now())
  startTime      DateTime      @default(now())
  stopTime       DateTime?
  meetLink    String?
  
  claims Claim[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vitals    Vital[]
  diagnoses Diagnosis[]

  @@index([patientId])
  @@index([recordId])
}

// ── VITAL SIGNS ───────────────────────────────────────────────
// Structured vitals per encounter.
// All fields optional — record only what was measured.

model Vital {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])

  // Haemodynamics
  systolicBP  Float? // mmHg
  diastolicBP Float? // mmHg
  heartRate   Float? // beats per minute
  meanABP     Float? // Mean arterial blood pressure mmHg

  // Respiratory
  respiratoryRate Float? // breaths per minute
  spO2            Float? // oxygen saturation %

  // Temperature
  temperature Float? // degrees Celsius

  // Anthropometrics
  weight Float? // kg
  height Float? // cm
  bmi    Float? // calculated — store for audit

  // Neurological
  gcs Int? // Glasgow Coma Scale 3–15

  // Additional
  urineOutput Float? // mL/hr (relevant for inpatient)
  painScore   Int?   // 0–10 numeric pain scale

  recordedBy String   // Staff ID
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([encounterId])
  @@index([patientId])
}

// ── DIAGNOSIS ─────────────────────────────────────────────────
// ICD-10 coded diagnoses linked to specific encounters.
// A patient builds a cumulative problem list over time.

model Diagnosis {
  id             String          @id @default(cuid())
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  encounterId    String
  encounter      Encounter       @relation(fields: [encounterId], references: [id])

  name           String          // e.g. "Type 2 Diabetes Mellitus"
  icdCode        String?         // e.g. "E11"
  icdDescription String?         // Full ICD-10 descriptor
  status         DiagnosisStatus @default(ACTIVE)
  isPrimary      Boolean         @default(false) // Primary dx for this encounter
  notes          String?         // Clinician notes on this diagnosis

  diagnosedBy String   // Staff ID
  diagnosedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@index([encounterId])
  @@index([icdCode])
}

// ── ALLERGY ───────────────────────────────────────────────────
// Patient allergy register. Standalone — not tied to an encounter
// because allergies persist across the patient's lifetime.

model Allergy {
  id        String          @id @default(cuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id])

  substance String          // e.g. "Penicillin", "Peanuts", "Latex"
  reaction  String          // e.g. "Anaphylaxis", "Urticaria", "Rash"
  severity  AllergySeverity
  status    AllergyStatus   @default(ACTIVE)

  // Cross-reactivity hint stored for EVEE rule engine
  drugClass String?         // e.g. "Penicillin", "Cephalosporin", "NSAID"

  onsetDate  DateTime?      // When allergy was first noted
  confirmed  Boolean        @default(false)  // Confirmed by allergy test
  recordedBy String         // Staff ID
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

// ── EXISTING MODELS (unchanged) ───────────────────────────────

model Report {
  id            String  @id @default(cuid())
  recordId      String
  record        Record  @relation(fields: [recordId], references: [id])
  title         String
  content       Json?
  attachmentUrl String?
  doctorName    String
  category      String
  results       Result[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Medication {
  id           String    @id @default(cuid())
  recordId     String
  record       Record    @relation(fields: [recordId], references: [id])
  name         String    // e.g. "Amoxicillin"
  dosage       String    // e.g. "500mg"
  route        String    // e.g. "Oral", "Intravenous"
  frequency    String    // e.g. "Twice daily"
  instructions String?
  startDate    DateTime
  endDate      DateTime?
  status       MedStatus @default(ACTIVE)
  prescribedBy String    // Staff ID
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Admission {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
  roomNumber   String?
  bedNumber    String?
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
}

model PatientUser {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String         @id @default(cuid())
  name        String         @unique
  labCode     String?        @unique
  category    String?
  description String?
  price       Float
  template    Template?      @relation(fields: [templateId], references: [id])
  templateId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      OrderService[]
  tariffs Tariff[]
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
}

model Template {
  id         String       @id @default(cuid())
  name       String       @unique
  description String?
  type       TemplateType
  dataSchema Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  services   Service[]
  results    Result[]

  department Department
  isActive   Boolean    @default(true) // Only active templates can be used for new orders
  version    Int        @default(1) 
  createdBy  String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
}

model Order {
  id        String       @id @default(cuid())
  patient   Patient      @relation(fields: [patientId], references: [id])
  patientId String
  paymentMethod PaymentMethod   @default(CASH)
  status    OrderStatus  @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  services  OrderService[]
  claims Claim[]
  results   Result[]

  @@index([patientId])
  @@index([status])
}

model OrderService {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  service   Service  @relation(fields: [serviceId], references: [id])
  serviceId String
  createdAt DateTime @default(now())

  @@unique([orderId, serviceId])
}

model Result {
  id         String       @id @default(cuid())
  record     Record       @relation(fields: [recordId], references: [id])
  recordId   String
  report     Report?      @relation(fields: [reportId], references: [id])
  reportId   String?
  patient    Patient      @relation(fields: [patientId], references: [id])
  patientId  String
  order      Order        @relation(fields: [orderId], references: [id])
  orderId    String
  template   Template     @relation(fields: [templateId], references: [id])
  templateId String
  data       Json
  imageUrl   String?
  status     ResultStatus @default(PENDING)
  version    Int          @default(1)
  
  department    Department

  verifiedBy    String?
  verifiedAt    DateTime?
  verifierRole  String?
  signatureHash String?

  releasedAt    DateTime?
  releasedBy    String?

  lockedBy      String?
  lockedAt      DateTime?

  editSession   ResultEditSession?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([patientId])
  @@index([orderId])
  @@index([templateId])
  @@index([status])
  @@index([department])
}

model ResultEditSession {
  id          String    @id @default(cuid())
  resultId    String    @unique
  result      Result    @relation(fields: [resultId], references: [id])
  staffId     String
  draftData   Json?
  startedAt   DateTime  @default(now())
  lastSavedAt DateTime?
  expiresAt   DateTime

  @@index([staffId])
}

model Staff {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  role        StaffRole
  email       String    @unique
  password    String
  phoneNumber String?
  maritalStatus MaritalStatus?
  religion      String?
  leaveStatus   LeaveStatus @default(ACTIVE)
  nok           StaffNextOfKin?

  department Department? 
  isHOD      Boolean     @default(false) // Head of Department flag
  canVerify  Boolean     @default(false) // Can verify results (e.g. lab techs)
  status     AccountStatus @default(ACTIVE)
  SignUpRequest SignupRequest? // Staff ID of the admin who created this account

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
}

model StaffNextOfKin {
  id          String   @id @default(cuid())
  staff       Staff    @relation(fields: [staffId], references: [id])
  staffId     String   @unique
  firstName   String
  lastName    String
  relation    String
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SignupRequest {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String
  profession    String        // e.g. "Medical Laboratory Scientist"
  role          StaffRole
  department    Department
  facility      String?       // Name of the facility they're applying to
  licenseNumber String?       // Professional license/registration number
  message       String?       // Optional note from applicant

  status        SignupRequestStatus @default(PENDING)
  reviewedBy    String?       // Staff ID of admin who reviewed
  reviewedAt    DateTime?
  reviewNotes   String?       // Admin notes on approval/rejection

  // If approved, link to the created Staff record
  createdStaffId String?      @unique
  createdStaff   Staff?       @relation(fields: [createdStaffId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // e.g. "VIEW_RESULT", "UPDATE_MEDICATION"
  entityId   String
  entityType String   // e.g. "Result", "Patient"
  ipAddress  String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String   
  createdAt  DateTime @default(now())
}

// ── EVEE CDSS MODELS ──────────────────────────────────────────

// EveeEvaluation — one record per time a doctor runs EVEE on a patient.
// Full audit trail: who ran it, when, how many alerts fired.

model EveeEvaluation {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  triggeredBy    String   // Staff ID of the clinician who ran EVEE
  ruleSetVersion Int      // Version of the rule set active at time of evaluation
  alertCount     Int      // Total alerts fired
  criticalCount  Int      // Critical alerts specifically
  mlScore        Float?   // XGBoost risk score (null until ML layer is active)
  mlLabel        String?  // e.g. "HIGH_RISK", "LOW_RISK" (beta)
  createdAt      DateTime @default(now())

  alerts EveeAlert[]

  @@index([patientId])
  @@index([triggeredBy])
}

// EveeAlert — one record per alert fired within an evaluation.
// Tracks whether the doctor acknowledged or overrode it, and why.

model EveeAlert {
  id             String         @id @default(cuid())
  evaluationId   String
  evaluation     EveeEvaluation @relation(fields: [evaluationId], references: [id])

  ruleId         String         // e.g. "DDI-001"
  domain         EveeDomain
  severity       EveeSeverity
  message        String
  recommendation String

  // Override tracking — medico-legal record of dismissal
  overridden     Boolean   @default(false)
  overriddenBy   String?   // Staff ID
  overrideReason String?   // Free text — why was this alert dismissed?
  overriddenAt   DateTime?

  createdAt DateTime @default(now())

  @@index([evaluationId])
  @@index([ruleId])
  @@index([severity])
}

model GoogleCredential {
  id           String   @id @default(cuid())
  staffId      String   @unique
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PlanTier {
  TIER_1    // 1-15 staff
  TIER_2    // 16-50 staff
  TIER_3    // 51-100 staff
  TIER_4    // 100+ staff
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  EXPIRED
}

enum BillingStatus {
  DRAFT
  FINALIZED
  PAID
  OVERDUE
}


// ── PROCUREMENT DEFINITIONS: SUPPLIER ────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String          // "Emzor Pharmaceuticals", "ABC Medical Supplies"
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  products    String?         // comma-separated or JSON — what they supply
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      PurchaseOrder[]
  inventoryItems InventoryItem[]
}

// ── REQUEST PORTAL ──────────────────────────────────────────

enum RequestType {
  ITEM_REQUEST
  FUND_DISBURSEMENT
  RESULT_APPROVAL
  TEMPORARY_ACCESS
  MAINTENANCE_REQUEST
  LEAVE_REQUEST
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model Request {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  type          RequestType
  status        RequestStatus @default(PENDING)
  title         String              // "Restock surgical gloves — running low"
  description   String?             // Detailed reason
  purchaseOrders PurchaseOrder[]
  amount        Decimal?            // for FUND_DISBURSEMENT
  requestedBy   String              // Staff ID
  approvedBy    String?             // Staff ID (Billing Officer or Manager)
  approvedAt    DateTime?
  rejectionReason String?
  fulfilledAt   DateTime?
  referenceId   String?             // Linked entity ID (result, encounter, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
}

// ── PURCHASE ORDER ──────────────────────────────────────────

model PurchaseOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  requestId     String?
  request       Request? @relation(fields: [requestId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal
  expenses      Expense[]
  notes         String?
  orderedBy     String        // Staff ID (Procurement Officer)
  receivedAt    DateTime?
  invoiceUrl    String?       // Uploaded invoice image/PDF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PurchaseOrderItem[]

  @@index([tenantId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemName        String
  quantity        Float
  unitPrice       Decimal
  totalPrice      Decimal
}

// ── INVENTORY (updated) ─────────────────────────────────────

model InventoryItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  description   String?
  category      String?        // Pharmacy, Lab, Imaging, General
  unit          String         // "boxes", "bottles", "pairs"
  quantity      Float
  flagLevel     Float          // alert when stock drops below this
  unitPrice     Float?         // cost price per unit
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  expiryDate    DateTime?
  lastRestocked DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  InventoryTransaction[]
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        TransactionType
  quantity    Float
  unitPrice   Float?
  reference   String?
  performedBy String
  createdAt   DateTime @default(now())
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  DISPENSED
  EXPIRED
  ADJUSTMENT
}

// ── EXPENSES ────────────────────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  expenses    Expense[] 
  description String?
  createdAt   DateTime @default(now())
}

model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  description   String
  amount        Decimal
  paymentMethod String?
  recipient     String?
  purchaseOrderId String?
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  approvedBy    String?
  recordedBy    String
  expenseDate   DateTime @default(now())
  createdAt     DateTime @default(now())
}